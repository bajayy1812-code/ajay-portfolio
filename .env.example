# Environment Variables for Resend Email Delivery
# Copy these to your Vercel Project Settings > Environment Variables

# Required: Your secret API Key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Required: The destination email address where recruiter messages will be delivered
CONTACT_EMAIL=bajayy1812@gmail.com

# Optional: Sender identity address.
# Defaults to "Portfolio Contact <onboarding@resend.dev>" which sends to your Resend account email (bajayy1812@gmail.com)
# Once you verify a custom domain on Resend (e.g., yourdomain.com), update to:
# RESEND_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
